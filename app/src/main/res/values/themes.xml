<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.CamView" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:colorBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg_deep</item>
        <item name="android:navigationBarColor">@color/bg_deep</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorSecondary">@color/muted</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:colorControlNormal">@color/muted</item>
        <item name="android:colorControlActivated">@color/accent</item>
        <item name="android:alertDialogTheme">@style/Theme.CamView.Dialog</item>
        <item name="android:datePickerDialogTheme">@style/Theme.CamView.Dialog</item>
        <item name="android:timePickerDialogTheme">@style/Theme.CamView.Dialog</item>
    </style>

    <style name="Theme.CamView.Dialog" parent="android:Theme.Material.Dialog.NoActionBar">
        <item name="android:windowBackground">@drawable/bg_dialog</item>
        <item name="android:colorBackground">@color/panel</item>
        <item name="android:textColorPrimary">@color/text</item>
        <item name="android:textColorHint">@color/muted</item>
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowMinWidthMajor">86%</item>
        <item name="android:windowMinWidthMinor">86%</item>
    </style>

    <style name="Theme.CamView.Fullscreen" parent="Theme.CamView">
        <item name="android:windowBackground">@color/bg_deep</item>
        <item name="android:windowFullscreen">true</item>
    </style>

    <style name="TitleText">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">17sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="LabelText">
        <item name="android:textColor">@color/muted</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="ValueText">
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="ToolbarButton">
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:paddingLeft">12dp</item>
        <item name="android:paddingRight">12dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:gravity">center</item>
    </style>

    <style name="GreenButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_green</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="DangerButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_button_red</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="PlainButton" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/bg_toolbar_button</item>
        <item name="android:textColor">@color/text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>
</resources>
